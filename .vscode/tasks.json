{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "[DB] Wake Database",
        "type": "shell",
        "command": "docker compose start ac-database",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        }
      },
      {
        "label": "[DB] Hibernate Database",
        "type": "shell",
        "command": "docker compose stop ac-database",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        }
      },
      {
        "label": "[DB] Hard Reset (Tear Down Network)",
        "type": "shell",
        "command": "docker compose down",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "[Run] Authserver (Native)",
        "type": "shell",
        "command": "./env/dist/bin/authserver",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "[Run] Worldserver (Native)",
        "type": "shell",
        "command": "./env/dist/bin/worldserver",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "[Build] Compile Core (Debug)",
        "type": "shell",
        "command": "CTYPE=Debug MTHREADS=4 ./acore.sh compiler build",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        }
      },
      {
        "label": "[Build] Recompile Core (Debug)",
        "type": "shell",
        "command": "CTYPE=Debug MTHREADS=4 ./acore.sh compiler clean",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "[Util] Azerothcore Dashboard",
        "type": "shell",
        "command": "./acore.sh",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "[Init] Download Client Data",
        "type": "shell",
        "command": "docker compose up ac-client-data-init",
        "group": "none"
      },
      {
        "label": "[Init] Import DB",
        "type": "shell",
        "command": "docker compose up ac-db-import",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        }
      },
      {
        "label": "[Util] Check Codestyle (C++)",
        "type": "shell",
        "command": "python apps/codestyle/codestyle-cpp.py",
        "group": "none"
      },
      {
        "label": "[Util] Check Codestyle (SQL)",
        "type": "shell",
        "command": "python apps/codestyle/codestyle-sql.py",
        "group": "none"
      },
      {
        "label": "[Util] Generate mod-ale Lua Stubs",
        "type": "shell",
        "command": "python3 tools/gen_mod_ale_lua_stubs.py",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "[Status] Check All Services",
        "type": "shell",
        "command": "bash apps/startup-scripts/usr/check_services_status.sh",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
